{
  "name": "dsh-voice-cues-friday",
  "version": "1.0.0",
  "description": "Short spoken cues when a turn finishes, an approval is requested, or the agent asks a question. Ships a “星期五” voice pack. macOS, Windows and Linux. · 回合结束、请求授权、提问时的语音提示音，含“星期五”语音包。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "sound",
    "alert",
    "accessibility",
    "voice-pack"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "audio",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangfujian762/dsh-voice-cues-friday.git"
  },
  "homepage": "https://github.com/wangfujian762/dsh-voice-cues-friday"
}
